name: retards_aeroports_catboost

docker_env:
  image: patludolead38/sample-ml-workflow:latest
  environment:
    - MLFLOW_TRACKING_URI
    - AWS_ACCESS_KEY_ID
    - AWS_SECRET_ACCESS_KEY
    - AWS_DEFAULT_REGION

entry_points:
  main:
    parameters:
      model_type: {type: string, default: "arrivals"}
      run_id: {type: string, default: "2026-05-25_124326_039dd1"}
      experiment_name: {type: string, default: "Experience_1"}

      # CatBoost Hyperparameters (léger pour t3.small)
      iterations: {type: int, default: 40}
      learning_rate: {type: float, default: 0.055}
      depth: {type: int, default: 2}
      loss_function: {type: string, default: "RMSE"}
      eval_metric: {type: string, default: "RMSE"}
      random_seed: {type: int, default: 42}
      early_stopping_rounds: {type: int, default: 300}
      task_type: {type: string, default: "CPU"}
      l2_leaf_reg: {type: float, default: 3}
      random_strength: {type: float, default: 1.0}
      bagging_temperature: {type: float, default: 0.7}

    command: >-
      python app/train.py
      --model_type {model_type}
      --run_id {run_id}
      --iterations {iterations}
      --learning_rate {learning_rate}
      --depth {depth}
      --loss_function {loss_function}
      --eval_metric {eval_metric}
      --random_seed {random_seed}
      --early_stopping_rounds {early_stopping_rounds}
      --task_type {task_type}
      --l2_leaf_reg {l2_leaf_reg}
      --random_strength {random_strength}
      --bagging_temperature {bagging_temperature}
